# Copy to .env.p0 (ignored by Git). Values are literal; this is not a shell script.
# Paths are decoded WebDAV paths relative to P0_WEBDAV_URL, not browser URLs.
P0_WEBDAV_URL=
P0_WEBDAV_USERNAME=
P0_WEBDAV_PASSWORD=
P0_SCAN_PATH=/
# Existing parent for newly generated .reeldock-p0-<uuid> directories only.
P0_TEST_ROOT=
# Optional remote sample and its matching local file, for Range/hash comparison.
P0_REMOTE_MEDIA=
P0_LOCAL_MEDIA=
# Comma-separated exact hostnames allowed for cross-origin GET redirects.
P0_REDIRECT_HOSTS=
P0_TIMEOUT_SECONDS=15
P0_PROBE_TIMEOUT_SECONDS=45
P0_PROBE_MAX_BYTES=67108864
P0_FFPROBE=ffprobe
P0_FFMPEG=ffmpeg
P0_SHOOTER_URL=https://www.shooter.cn/api/subapi.php
# Default uses the public test hash, never a user's file without configuration.
P0_SHOOTER_HASH=234b0ff3685d6c46164b6b48cd39d69f;8be57624909f9d365dc81df43399d496;436de72e3c36a05a07875cc3249ae31a;237f498cfee89c67a22564e61047b053
P0_SHOOTER_FILENAME=S05E09.mkv

# P1 application (copy these keys to .env.app; do not reuse P0 paths automatically).
REELDOCK_DATA_DIR=data
REELDOCK_FRONTEND_DIR=frontend/dist
REELDOCK_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
REELDOCK_SECURE_COOKIE=false
REELDOCK_WORKER_ENABLED=true
REELDOCK_WORKER_CONCURRENCY=2
REELDOCK_LEASE_SECONDS=30
