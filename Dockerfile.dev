# P1 development/verification image; no release image or registry publication.
ARG NODE_IMAGE=node:22-bookworm-slim
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${NODE_IMAGE} AS frontend
WORKDIR /ui
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM ghcr.io/astral-sh/uv:0.9.10 AS uv
FROM ${PYTHON_IMAGE} AS development
COPY --from=uv /uv /uvx /bin/
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy PYTHONUNBUFFERED=1 \
    REELDOCK_DATA_DIR=/data REELDOCK_FRONTEND_DIR=/opt/reeldock/frontend
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project
COPY backend/ ./backend/
RUN uv sync --frozen --no-editable && \
    groupadd --gid 10001 reeldock && useradd --uid 10001 --gid 10001 --create-home reeldock && \
    mkdir /data && chown reeldock:reeldock /data
COPY --from=frontend /ui/dist /opt/reeldock/frontend
USER reeldock
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2)"]
CMD ["/app/.venv/bin/uvicorn", "reeldock.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
